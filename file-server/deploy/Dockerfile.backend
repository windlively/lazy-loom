# ===== 构建阶段 =====
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build

# 复制父 POM 并以非递归模式安装（跳过不存在的子模块）
COPY pom.xml .
RUN mvn install -N -q -DskipTests

# 复制 file-server 模块
COPY file-server/pom.xml ./file-server/
COPY file-server/src ./file-server/src

# 构建 file-server
RUN cd file-server && mvn clean package -DskipTests -q

# ===== 运行阶段 =====
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=builder /build/file-server/target/file-server-*.jar app.jar

ENV JAVA_OPTS=""
ENV SERVER_PORT=8080
ENV FILE_SERVER_WORKSPACE=/data

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -Dserver.port=$SERVER_PORT -Dfile-server.workspace=$FILE_SERVER_WORKSPACE -jar app.jar"]
